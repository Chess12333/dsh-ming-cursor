{
  "name": "dsh-ming-cursor",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "桌面上的一只 AI 光标：画出来、滑过去、说一句话。不截屏、不点击、不碰键盘。",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./cursor-core.ps1": "./cursor-core.ps1",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "lib",
    "assets",
    "cursor-core.ps1",
    "fix-ps.mjs",
    "cordis.patch.yml",
    "README.md"
  ],
  "keywords": [
    "dsh",
    "deepseek-harness",
    "cordis",
    "plugin",
    "cursor",
    "overlay"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots"
      ]
    }
  },
  "license": "MIT"
}
